# Gemini via Google AI Studio (OpenAI-compatible endpoint)
GEMINI_API_KEY=your_google_ai_studio_key_here

# GitHub (for creating Issues)
GITHUB_TOKEN=ghp_your_github_personal_access_token

# LangFuse (self-hosted on VPS, see docker-compose.yml)
# In Docker: LANGFUSE_HOST is set to http://langfuse:3000 via docker-compose env
# For local dev outside Docker use: http://localhost:9300
LANGFUSE_PUBLIC_KEY=pk-lf-your_public_key
LANGFUSE_SECRET_KEY=sk-lf-your_secret_key
